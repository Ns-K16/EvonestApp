{
  "expo": {
    "name": "EvonestApp",
    "slug": "evonest-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "evonestapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ns.evonestapp"
    },
    "android": {
      "package": "com.ns.evonestapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "866e21a7-a158-4a27-9c27-31225604d7ee"
      }
    }
  }
}
